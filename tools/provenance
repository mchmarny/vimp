#!/bin/bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/common
. "${DIR}/common"

has_tools gcloud slsa-verifier

# Usage: ./tools/provenance [image@sha256:digest]
image="${1:-${VIMP_IMAGE:-}}"
if [ -z "$image" ]; then
    echo "Usage: $0 <image@sha256:digest>" >&2
    echo "Or set VIMP_IMAGE environment variable" >&2
    exit 1
fi

# Get version from git tags
version=$(git describe --tags --abbrev=0 2>/dev/null || err "No git tags found")
provenance="provenance.json"

cleanup() {
    rm -f "$provenance"
}
trap cleanup EXIT

msg "Fetching provenance for $image..."
gcloud artifacts docker images describe "$image" --show-provenance --format json > "$provenance"

msg "Verifying SLSA provenance..."
slsa-verifier verify-image "$image" \
    --provenance-path "$provenance" \
    --source-uri "github.com/mchmarny/vimp" \
    --source-tag "$version"

msg "Provenance verified successfully for $image"
