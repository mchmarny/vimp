#!/usr/bin/env bash
# Verifies required tools are installed and shows version comparison

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/common
. "${DIR}/common"
VERSIONS_FILE="${REPO_ROOT}/.versions.yaml"

if ! command -v yq &>/dev/null; then
    log_error "yq is required: brew install yq"
    exit 1
fi

if [[ ! -f "${VERSIONS_FILE}" ]]; then
    log_error "Version file not found: ${VERSIONS_FILE}"
    exit 1
fi

# Tool metadata: yaml_key -> "command:::version_cmd:::match_strategy"
get_tool_metadata() {
    local yaml_key="$1"
    case "$yaml_key" in
        go)
            echo "go:::go version 2>/dev/null | grep -oE 'go[0-9]+\.[0-9]+' | sed 's/go//':::major_minor"
            ;;
        goreleaser)
            echo "goreleaser:::goreleaser --version 2>/dev/null | sed -n 's/^GitVersion:[[:space:]]*//p':::major"
            ;;
        ko)
            echo "ko:::ko version 2>/dev/null | head -1:::major_minor"
            ;;
        crane)
            echo "crane:::crane version 2>/dev/null:::major_minor"
            ;;
        syft)
            echo "syft:::syft version 2>/dev/null | head -1:::major_minor"
            ;;
        git_cliff)
            echo "git-cliff:::git-cliff --version 2>/dev/null | awk '{print \$2}':::major"
            ;;
        golangci_lint)
            echo "golangci-lint:::golangci-lint version --short 2>/dev/null:::major"
            ;;
        yamllint)
            echo "yamllint:::yamllint --version 2>/dev/null | awk '{print \$2}':::major"
            ;;
        cosign)
            echo "cosign:::cosign version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+':::major_minor"
            ;;
        trivy)
            echo "trivy:::trivy --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+':::major_minor"
            ;;
        grype)
            echo "grype:::grype version 2>/dev/null | grep -E '^Version:' | awk '{print \$2}':::major_minor"
            ;;
        *)
            echo ""
            ;;
    esac
}

get_major() {
    echo "$1" | sed 's/^v//' | cut -d. -f1
}

get_major_minor() {
    echo "$1" | sed 's/^v//' | cut -d. -f1,2
}

compare_versions() {
    local expected="$1"
    local installed="$2"
    local strategy="$3"

    case "$strategy" in
        exact)
            [[ "$installed" == "$expected" ]]
            ;;
        major)
            [[ "$(get_major "$expected")" == "$(get_major "$installed")" ]]
            ;;
        major_minor)
            [[ "$(get_major_minor "$expected")" == "$(get_major_minor "$installed")" ]]
            ;;
        presence)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

print_row() {
    printf "%-20s %-15s %-15s %s\n" "$1" "$2" "$3" "$4"
}

check_tool() {
    local yaml_key="$1"
    local expected_version="$2"

    local metadata
    metadata=$(get_tool_metadata "$yaml_key")
    if [[ -z "$metadata" ]]; then
        return
    fi

    local cmd_name="${metadata%%:::*}"
    local rest="${metadata#*:::}"
    local version_cmd="${rest%%:::*}"
    local match_strategy="${rest##*:::}"

    if ! command -v "$cmd_name" &>/dev/null; then
        print_row "$cmd_name" "$expected_version" "-" "✗"
        return
    fi

    local installed_version
    installed_version=$(eval "$version_cmd" 2>/dev/null || echo "unknown")

    if compare_versions "$expected_version" "$installed_version" "$match_strategy"; then
        print_row "$cmd_name" "$expected_version" "$installed_version" "✓"
    else
        print_row "$cmd_name" "$expected_version" "$installed_version" "⚠"
    fi
}

echo "=== Tool Version Check ==="
echo ""
print_row "Tool" "Expected" "Installed" "Status"
print_row "----" "--------" "---------" "------"

# Get all categories from .versions.yaml
categories=$(yq 'keys | .[]' "${VERSIONS_FILE}")

for category in $categories; do
    while IFS= read -r tool; do
        [ -z "$tool" ] && continue
        expected=$(yq ".$category.$tool" "${VERSIONS_FILE}")
        check_tool "$tool" "$expected"
    done < <(yq ".$category | keys | .[]" "${VERSIONS_FILE}" 2>/dev/null)
done

# Check docker separately
if command -v docker &>/dev/null; then
    installed=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo "not running")
    if [[ "$installed" == "not running" ]]; then
        print_row "docker" "-" "not running" "⚠"
    else
        print_row "docker" "-" "$installed" "✓"
    fi
else
    print_row "docker" "-" "-" "✗"
fi

echo ""
echo "Legend: ✓ = installed, ⚠ = version mismatch, ✗ = missing"
